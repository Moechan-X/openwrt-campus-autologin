config login 'login'
	option username '你的账号'
	option password '你的密码'
	# 认证服务器地址
	option portal_host '10.2.1.27'
	# 在线检测地址 (必须为 HTTP, 返回 204 表示在线)
	option check_url 'http://connect.rom.miui.com/generate_204'
	# 看门狗检测间隔 (秒), 登录连续失败会自动退避, 上限 300
	option interval '30'
	# 可选: 重定向抓取失败时使用的固定认证 URL 模板
	# (IP 变化后需手动更新, 一般留空即可)
	option portal_url ''
