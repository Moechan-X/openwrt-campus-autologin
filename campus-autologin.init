#!/bin/sh /etc/rc.common
# campus-autologin init 脚本 - procd 常驻看门狗

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/bin/campus-autologin.sh --watchdog
	# 崩溃自动拉起: 3600s 内最多 5 次, 0 = 无限重试
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}
